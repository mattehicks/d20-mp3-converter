{
  "name": "d20-mp3-converter",
  "version": "1.0.0",
  "description": "Converts music files to widely compatible MP3 (CBR, ID3v2.3, small baseline-JPEG covers, FAT32-safe names). Clean: leaves no trace on disk.",
  "main": "main.js",
  "author": "Matt",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "fixtures": "node test/make-fixtures.js",
    "test": "node test/headless.js",
    "test:e2e": "node test/e2e-cdp.js",
    "test:audit": "node test/disk-audit.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thetruett.d20mp3converter",
    "productName": "D20 MP3 Converter",
    "files": ["main.js", "preload.js", "engine.js", "index.html", "style.css", "renderer.js", "clean/**/*", "node_modules/**/*"],
    "asarUnpack": ["node_modules/@ffmpeg-installer/**", "node_modules/@ffprobe-installer/**"],
    "directories": { "output": "dist" },
    "win": { "icon": "assets/icon.png", "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "runAfterFinish": false, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "D20 MP3 Converter", "artifactName": "D20Mp3Converter-Setup-${version}.exe" },
    "portable": { "artifactName": "D20Mp3Converter-Portable-${version}.exe" }
  }
}
